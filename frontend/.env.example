# Copy to .env and adjust if your API runs elsewhere.
# Local Flask API (default).
# Port 5001 rather than 5000 — macOS AirPlay Receiver holds 5000.
VITE_API_BASE=http://localhost:5001

# To point at the Render deployment instead:
# VITE_API_BASE=https://hiremind-phpb.onrender.com

# Seconds allowed per question before the timer auto-submits.
VITE_TIMER_SECONDS=180
